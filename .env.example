# Copie para .env e ajuste se necessario. O .env nunca vai para o git.

# Execucao local (fora do Docker). Diretorios relativos a raiz do projeto.
TRIAGEM_DATA_DIR=data
TRIAGEM_ARTIFACTS_DIR=artifacts

# Docker Compose: portas publicadas em 127.0.0.1. Troque se alguma ja estiver em uso.
API_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Senha do usuario admin do Grafana. Sem valor padrao de proposito: escolha a sua.
GRAFANA_ADMIN_PASSWORD=
